{
  "name": "@fringeworks/style-layouts",
  "version": "0.10.4",
  "private": true,
  "description": "A library some will find handy, specialized in controlling child element layout with CSS.",
  "keywords": [
    "css",
    "style",
    "layout"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fringeworks-js/style-layouts.git"
  },
  "license": "MIT",
  "author": "Mitsuhiro Seino",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants.ts",
    "./helpers/*": "./src/helpers/*.ts",
    "./styles.scss": "./src/styles.scss",
    "./styles.css": "./src/styles.scss",
    "./*.scss": "./src/*/styles.scss",
    "./*.css": "./src/*/styles.scss",
    "./with-css": "./src/with-css/index.ts",
    "./with-css/*": "./src/with-css/*/index.ts",
    "./*": "./src/*/index.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "scripts": {
    "build": "tsdown",
    "build-storybook": "storybook build",
    "check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "indexes": "tsx scripts/indexes.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "pnpm build && npm publish ./dist",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "tidy": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" --config ./prettier.tidy.config.ts"
  },
  "dependencies": {
    "@fringeworks/style-utils": "^1.0.0",
    "@fringeworks/types": "^1.3.0",
    "@fringeworks/utils": "^2.4.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@fringeworks/dev": "^0.14.0",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/web-components-vite": "^10.6.7",
    "@tsdown/css": "^0.23.7",
    "@types/chroma-js": "^3.1.3",
    "@types/node": "^25.9.9",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "chroma-js": "^3.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-storybook": "^10.6.7",
    "lit": "^3.3.3",
    "lit-html": "^3.3.3",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "sass": "^1.108.2",
    "storybook": "^10.6.7",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@12.21.0"
}
